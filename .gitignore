# Protesto SaaS — monorepo (api + app + docs)

# --- Sistema / IDE ---
.DS_Store
Thumbs.db
.vscode/
.idea/
.cursor/

# Repositórios Git aninhados (evitar submodules acidentais)
api/.git/
app/.git/

# --- Variáveis de ambiente e segredos ---
.env
.env.*
!.env.example
!.env.*.example

# --- Python (api/) ---
api/venv/
api/.venv/
**/__pycache__/
*.py[cod]
*$py.class
api/.pytest_cache/
.pytest_cache/
*.log
*.sqlite3
.coverage
htmlcov/
coverage.xml
api/dist/
api/build/
.eggs/
*.egg-info/
pip-wheel-metadata/
*.egg
.cache/
.tox/

# Conexão / artefatos locais da API
api/config/database/firebird.json
api/storage/
!api/storage/temp/
!api/storage/temp/.gitkeep

# --- Node / Next.js (app/) ---
app/node_modules/
app/.pnp
app/.pnp.*
app/.yarn/*
!app/.yarn/patches
!app/.yarn/plugins
!app/.yarn/releases
!app/.yarn/versions
app/coverage/
app/.next/
app/out/
app/build/
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
app/.vercel
*.tsbuildinfo
app/next-env.d.ts

# --- Demos e temporários (docs e raiz) ---
demos/
docs/demos/
