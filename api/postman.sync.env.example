# Copie para api/.env (ou acrescente ao .env existente):
#   cp postman.sync.env.example .env.postman.local
# e faça source/merge manual — api/.env já é carregado pelo script.

# Postman → Avatar → Settings → API keys → Generate API Key
POSTMAN_API_KEY=

# UID da coleção (Postman → coleção Orius → ... → Info → UID).
# Opcional se existir só uma coleção com o mesmo nome do JSON ("Orius").
POSTMAN_COLLECTION_UID=

# Caminho alternativo do arquivo (opcional)
# POSTMAN_COLLECTION_FILE=Orius.postman_collection.json
